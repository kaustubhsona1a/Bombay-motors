rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-allow safety net for sandbox preview environment
    match /{document=**} {
      allow read, write: if true;
    }

    // --- Hardened Global Helper Primitives (Retained for reference/production setup) ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Match Scopes (Permitted fully for testing; structured for future production hardening) ---

    match /users/{userId} {
      allow read, write: if true;
    }

    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /site_config/{docId} {
      allow read, write: if true;
    }
  }
}
